probe_job() {
  pd=$1 conf=$2 w=$3 h=$4 theme=$5 net=$6
  cd_=$pd/$conf; mkdir -p "$cd_"
  hash="page=page.html&w=$w&h=$h&theme=$theme&y=0&probe=1"
  set --
  set -- --screenshot="$(cat "$pd/shots")/$conf-top.png"
  if [ "$net" = off ]; then
    launch "$cd_" "file://$pd/wrap.html#$hash&off=1" "$w,$h" "$@" --host-resolver-rules='MAP * ~NOTFOUND' || : > "$cd_/failed"
  else
    launch "$cd_" "file://$pd/wrap.html#$hash" "$w,$h" "$@" || : > "$cd_/failed"
  fi
}

plan() {
  awk -F "$tab" -v W="$3" -v H="$4" -v conf="$2" -v dir="$1" '
    $1 == "size" { height = $2; iw = $3 }
    $1 == "find" { n++; y[n] = $2; msg[n] = $3; at[n] = $4 }
    $1 == "note" { print "note" FS FS $3 > (dir "/notes") }
    END {
      if (iw && iw != W) print "note" FS FS "viewport is " iw "px, not " W "px" > (dir "/notes")
      per = W < 500 ? 4 : 1
      for (i = 1; i <= n; i++) {
        if (y[i] < H * 3 / 4) continue
        v = y[i] - int(H / 4); if (v > height - H) v = height - H; if (v < 0) v = 0
        for (t = 1; t <= nt && tile[t] != v && !(y[i] >= tile[t] && y[i] < tile[t] + H * 3 / 4); t++);
        if (t > nt) tile[++nt] = v
        of[i] = int((t - 1) / per) + 1
      }
      for (t = 1; t <= nt; t++) { k = int((t - 1) / per) + 1; ys[k] = ys[k] (ys[k] == "" ? "" : ",") tile[t] }
      for (k in ys) print conf "-" k FS ys[k] > (dir "/sheets")
      for (i = 1; i <= n; i++) print conf "-" (of[i] ? of[i] : "top") FS msg[i] FS at[i]
    }
  ' "$1/res" > "$1/finds"
}

sheet_job() {
  cd_=$1 name=$2 ys=$3 w=$4 h=$5 theme=$6 net=$7
  sd=$cd_/$name; mkdir -p "$sd"
  cp -R "$cd_/cache" "$sd/cache" 2> /dev/null || :
  n=$(echo "$ys" | awk -F, '{ print NF }')
  url="file://$(dirname "$cd_")/wrap.html#page=page.html&w=$w&h=$h&theme=$theme&y=$ys"
  set -- --screenshot="$(cat "$(dirname "$cd_")/shots")/$name.png"
  [ "$net" = off ] && set -- "$@" --host-resolver-rules='MAP * ~NOTFOUND'
  [ "$net" = off ] && url="$url&off=1"
  launch "$sd" "$url" "$((n * w + (n - 1) * 8)),$h" "$@" || : > "$sd/failed"
}

lanes() {
  k=0
  while [ "$k" -lt "$ncpu" ]; do
    awk -v k="$k" -v n="$ncpu" 'NR % n == k' "$1" | while IFS="$tab" read -r fn a b c d e f g; do "$fn" "$a" "$b" "$c" "$d" "$e" "$f" "$g"; done &
    k=$((k + 1))
  done
  wait
}

bin=$(find_browser)
case $bin in
  /snap/*) base=$HOME ;;
  *) base=${TMPDIR:-/tmp}; [ -n "$bin" ] && [ -d /snap ] && head -n 1 "$bin" 2> /dev/null | grep -q '^#!' && grep -q snap "$bin" && base=$HOME ;;
esac
work=$(mktemp -d "$base/visualize-check.XXXXXX")
cleanup() { pkill -f "$work" 2> /dev/null || :; rm -rf "$work"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
[ "$(id -u)" = 0 ] && : > "$work/nosandbox"
if [ -n "$bin" ]; then
  [ -n "$shots" ] || shots=$(mktemp -d "$base/visualize-shots.XXXXXX")
  mkdir -p "$shots"
  shots=$(CDPATH='' cd -- "$shots" && pwd)
fi

i=0
for p in "$@"; do
  i=$((i + 1)); pd=$work/$i; mkdir -p "$pd"
  static_checks "$p" > "$pd/raw" || { echo "check: static checks failed on $p" >&2; exit 2; }
  sort -t "$tab" -k1,1n -k2 "$pd/raw" | uniq > "$pd/static"
  [ -n "$bin" ] || continue
  if grep -q 'kit not inlined' "$pd/static"; then : > "$pd/skip"; continue; fi
  name=$(basename "$p" .html); sdir=$shots/$name
  [ -e "$work/name-$name" ] && sdir=$shots/$name-$i
  : > "$work/name-$name"; mkdir -p "$sdir"; echo "$sdir" > "$pd/shots"
  INJ=$inject awk 'NR == 1 { if (tolower($0) ~ /^<!doctype/) print $0 ENVIRON["INJ"]; else print ENVIRON["INJ"] $0; next } { print }' "$p" > "$pd/page.html"
  write_wrapper "$pd/wrap.html"
  echo "$configs" | while read -r conf w h theme net; do printf 'probe_job\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pd" "$conf" "$w" "$h" "$theme" "$net"; done >> "$work/jobs"
done

if [ -f "$work/jobs" ]; then
  ncpu=$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 4)
  [ "$ncpu" -le 8 ] || ncpu=8
  lanes "$work/jobs"
  while IFS="$tab" read -r fn pd conf w h theme net; do
    [ -f "$pd/$conf/failed" ] && continue
    plan "$pd/$conf" "$conf" "$w" "$h"
    [ -f "$pd/$conf/sheets" ] || continue
    while IFS="$tab" read -r sname ys; do
      printf 'sheet_job\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pd/$conf" "$sname" "$ys" "$w" "$h" "$theme" "$net"
    done < "$pd/$conf/sheets" >> "$work/sheetjobs"
  done < "$work/jobs"
  [ ! -f "$work/sheetjobs" ] || lanes "$work/sheetjobs"
fi

findings=0 unverified=0
i=0
for p in "$@"; do
  i=$((i + 1)); pd=$work/$i
  while IFS="$tab" read -r line msg; do echo "$p:$line: $msg"; findings=$((findings + 1)); done < "$pd/static"
  if [ -z "$bin" ]; then unverified=1; continue; fi
  if [ -f "$pd/skip" ]; then echo "$p: render skipped until the kit is inlined"; unverified=1; continue; fi
  sdir=$(cat "$pd/shots")
  for conf in 375-light 375-dark 1280-light 1280-dark 375-offline; do
    c=$pd/$conf
    if [ -f "$c/failed" ]; then
      echo "$p: $conf: render failed: $(tail -n 2 "$c/err" | tr '\n' ' ')"; unverified=1; continue
    fi
    [ -f "$c/finds" ] && sed "s|^|$conf$tab|" "$c/finds" >> "$pd/all"
    [ -f "$c/notes" ] && sed "s|^note$tab$tab|$conf$tab|" "$c/notes" >> "$pd/allnotes"
  done
  if [ -f "$pd/all" ]; then
    awk -F "$tab" -v page="$p" -v dir="$sdir" '
      !($3 in seen) { seen[$3] = ++n; key[n] = $3; confs[n] = $1; shot[n] = $2; at[n] = $4; next }
      { confs[seen[$3]] = confs[seen[$3]] ", " $1 }
      END {
        for (i = 1; i <= n; i++) {
          m = key[i]; pre = page ":"
          if (match(m, /^line [0-9]+: /)) { pre = page ":" substr(m, 6, RLENGTH - 7) ":"; m = substr(m, RLENGTH + 1) }
          gsub(/-/, " ", confs[i]); if (split(confs[i], tmp, ",") == 5) confs[i] = "all sizes"
          print pre " " confs[i] ": " m (at[i] != "" ? " (" at[i] ")" : "") " [" dir "/" shot[i] ".png]"
        }
      }' "$pd/all"
    findings=$((findings + $(awk -F "$tab" '!seen[$3]++' "$pd/all" | wc -l)))
  fi
  if [ -f "$pd/allnotes" ]; then
    awk -F "$tab" -v page="$p" '!seen[$2]++ { print page ": note: " $2 }' "$pd/allnotes"
    grep -q 'CDN unreachable' "$pd/allnotes" && unverified=1
  fi
  echo "$p: top screens: $sdir/{375-light,375-dark,1280-light,1280-dark,375-offline}-top.png"
done

[ -z "$bin" ] || [ ! -f "$work/nosandbox" ] || echo "note: browser ran with --no-sandbox"
if [ -z "$bin" ]; then
  echo "render: unverified (no Chromium-family browser found; set VISUALIZE_BROWSER)"
elif [ "$unverified" = 1 ]; then
  echo "render: partly unverified (see above)"
fi
echo "check: $findings finding(s)"
[ "$findings" -gt 0 ] && exit 1
[ -z "$bin" ] || [ "$unverified" = 1 ] && exit 3
exit 0
