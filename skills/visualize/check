#!/bin/sh
set -eu
kit=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
usage() { echo "usage: check [-o DIR] PAGE..." >&2; exit 2; }
shots=
while getopts o: opt; do
  case $opt in o) shots=$OPTARG ;; *) usage ;; esac
done
shift $((OPTIND - 1))
[ "$#" -gt 0 ] || usage
for p in "$@"; do [ -f "$p" ] || { echo "check: no such file: $p" >&2; exit 2; }; done
tab=$(printf '\t')

find_browser() {
  if [ "${VISUALIZE_BROWSER+set}" ]; then
    [ -x "$VISUALIZE_BROWSER" ] && [ ! -d "$VISUALIZE_BROWSER" ] && echo "$VISUALIZE_BROWSER"
    return 0
  fi
  for b in chromium chromium-browser google-chrome google-chrome-stable chrome microsoft-edge microsoft-edge-stable brave-browser brave; do
    command -v "$b" 2>/dev/null && return 0
  done
  for b in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium" \
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge" \
    "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" \
    "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "$HOME"/.cache/ms-playwright/chromium-*/chrome-linux*/chrome \
    "$HOME"/Library/Caches/ms-playwright/chromium-*/chrome-mac*/*.app/Contents/MacOS/* \
    "$HOME"/.cache/puppeteer/chrome/*/chrome-linux*/chrome \
    "$HOME"/.cache/puppeteer/chrome/*/chrome-mac*/*.app/Contents/MacOS/*; do
    [ -x "$b" ] && [ ! -d "$b" ] && { echo "$b"; return 0; }
  done
  return 0
}

static_checks() {
  awk -v css="$kit/kit.css" -v js="$kit/kit.js" '
    function ln(p,  t) { t = substr(s, 1, p); return gsub(/\n/, "", t) + 1 }
    function out(p, msg) { print ln(p) "\t" msg }
    function blank(t) { gsub(/[^\n]/, " ", t); return t }
    function wipe(t, re) { while (match(t, re)) t = substr(t, 1, RSTART - 1) blank(substr(t, RSTART, RLENGTH)) substr(t, RSTART + RLENGTH); return t }
    function colors(t, base, ctx,  u, p, st, h, k, b, r, v, q, w, n, i) {
      u = wipe(wipe(t, "url\\([^)]*\\)"), "var\\(--[A-Za-z0-9_-]*")
      p = 0
      while (match(substr(u, p + 1), /#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Za-z_-]*/)) {
        st = p + RSTART; h = substr(u, st, RLENGTH); p = st + RLENGTH - 1
        k = length(h) - 1
        if (h ~ /[^#0-9A-Fa-f]/ || (k != 3 && k != 4 && k != 6 && k != 8)) continue
        if (st > 1 && substr(u, st - 1, 1) ~ /[A-Za-z0-9_&-]/) continue
        r = substr(u, p + 1, 40); sub(/^[ \t\n]*/, "", r)
        if (substr(r, 1, 1) == "{") continue
        out(base + st, "color " h " in " ctx ": use a kit token")
      }
      p = 0
      while (match(substr(u, p + 1), /(rgba?|hsla?|hwb|oklab|oklch|lab|lch)\(/)) {
        st = p + RSTART; p = st + RLENGTH - 1
        if (st > 1 && substr(u, st - 1, 1) ~ /[A-Za-z0-9_.$-]/) continue
        out(base + st, "color " substr(u, st, RLENGTH) "...) in " ctx ": use a kit token")
      }
      p = 0
      while (match(substr(u, p + 1), /(color|background|background-color|fill|stroke|border|border-[a-z-]+|outline|outline-color|stop-color|flood-color|lighting-color|box-shadow|text-shadow|text-decoration|text-decoration-color|accent-color|caret-color|column-rule|column-rule-color|[a-zA-Z]+Color|fillStyle|strokeStyle)[ \t]*[:=][ \t]*/)) {
        st = p + RSTART; p = st + RLENGTH - 1
        if (st > 1 && substr(u, st - 1, 1) ~ /[A-Za-z0-9_-]/) continue
        v = substr(u, p + 1, 200); q = substr(v, 1, 1)
        if (q == "\"" || q == "\047") { v = substr(v, 2); sub(q ".*", "", v) } else sub(/[;}\n<>"\047].*/, "", v)
        n = split(tolower(v), w, /[^a-z]+/)
        for (i = 1; i <= n; i++) if (w[i] in named) { out(base + st, "color " w[i] " in " ctx ": use a kit token"); break }
      }
    }
    function attr(tag, name,  v) {
      if (!match(tag, "[ \t\n]" name "[ \t\n]*=[ \t\n]*(\"[^\"]*\"|\047[^\047]*\047|[^ \t\n>]+)")) return ""
      v = substr(tag, RSTART, RLENGTH); sub(/^[^=]*=[ \t\n]*/, "", v); gsub(/^["\047]|["\047]$/, "", v)
      return v
    }
    function islocal(v) { return v != "" && v !~ /^(https?:|data:|blob:|about:|mailto:|tel:|javascript:|#|\/\/)/ && v != "kit.css" && v != "kit.js" }
    function urls(t, base,  p, st, v) {
      p = 0
      while (match(substr(t, p + 1), /url\([ \t]*["\047]?[^)"\047]*/)) {
        st = p + RSTART; v = substr(t, st, RLENGTH); p = st + RLENGTH - 1
        sub(/^url\([ \t]*["\047]?/, "", v)
        if (islocal(v)) out(base + st, "local file " v ": inline it as a data: URI")
      }
    }
    function segs(open, cl, ctx,  p, a, b, e, tag) {
      p = 0
      while ((a = index(substr(lm, p + 1), open)) > 0) {
        a += p
        e = index(substr(lm, a), ">"); if (!e) break
        tag = substr(lm, a, e)
        b = index(substr(lm, a + e), cl); if (!b) break
        b += a + e - 1
        p = b
        if (open == "<script" && tag ~ /[ \t\n]src[ \t\n]*=/) continue
        if (open == "<pre" && tag !~ /class[ \t\n]*=[ \t\n]*"([^"]* )?mermaid( [^"]*)?"/) continue
        if (open == "<pre" && substr(s, a + e, b - a - e) !~ /[^ \t\n]/) out(a, "mermaid block is empty: put the source text in it")
        colors(substr(s, a + e, b - a - e), a + e - 1, ctx)
        if (ctx == "page CSS") urls(substr(s, a + e, b - a - e), a + e - 1)
        if (open != "<pre") m = substr(m, 1, a + e - 1) blank(substr(m, a + e, b - a - e)) substr(m, b)
      }
    }
    BEGIN {
      while ((getline l < css) > 0 && ++nc <= 2) c[nc] = l
      while ((getline l < js) > 0 && ++nj <= 2) j[nj] = l
      split("aliceblue antiquewhite aqua aquamarine azure beige bisque black blanchedalmond blue blueviolet brown burlywood cadetblue chartreuse chocolate coral cornflowerblue cornsilk crimson cyan darkblue darkcyan darkgoldenrod darkgray darkgreen darkgrey darkkhaki darkmagenta darkolivegreen darkorange darkorchid darkred darksalmon darkseagreen darkslateblue darkslategray darkslategrey darkturquoise darkviolet deeppink deepskyblue dimgray dimgrey dodgerblue firebrick floralwhite forestgreen fuchsia gainsboro ghostwhite gold goldenrod gray green greenyellow grey honeydew hotpink indianred indigo ivory khaki lavender lavenderblush lawngreen lemonchiffon lightblue lightcoral lightcyan lightgoldenrodyellow lightgray lightgreen lightgrey lightpink lightsalmon lightseagreen lightskyblue lightslategray lightslategrey lightsteelblue lightyellow lime limegreen linen magenta maroon mediumaquamarine mediumblue mediumorchid mediumpurple mediumseagreen mediumslateblue mediumspringgreen mediumturquoise mediumvioletred midnightblue mintcream mistyrose moccasin navajowhite navy oldlace olive olivedrab orange orangered orchid palegoldenrod palegreen paleturquoise palevioletred papayawhip peachpuff peru pink plum powderblue purple rebeccapurple red rosybrown royalblue saddlebrown salmon sandybrown seagreen seashell sienna silver skyblue slateblue slategray slategrey snow springgreen steelblue tan teal thistle tomato turquoise violet wheat white whitesmoke yellow yellowgreen", nl, " ")
      for (i in nl) named[nl[i]] = 1
    }
    { L[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (L[i] == "<style>" && L[i + 1] == c[1] && L[i + 2] == c[2]) { kitcss = 1; for (; i <= NR && L[i] != "</style>"; i++) L[i] = ""; L[i] = "" }
        else if (L[i] == "<script>" && L[i + 1] == j[1] && L[i + 2] == j[2]) { kitjs = 1; for (; i <= NR && L[i] != "</script>"; i++) L[i] = ""; L[i] = "" }
      }
      s = L[1]; for (i = 2; i <= NR; i++) s = s "\n" L[i]
      lm = tolower(s); m = s
      if (match(s, /<link[^>]*href="kit\.css"|<script[^>]*src="kit\.js"/)) out(RSTART, "kit not inlined: run inline on this page")
      else if (!kitcss || !kitjs) out(1, "kit not found inline: start from template.html and run inline")
      segs("<style", "</style", "page CSS")
      segs("<script", "</script", "page script")
      segs("<pre", "</pre", "Mermaid")
      lm = tolower(m)
      p = 0
      while (match(substr(lm, p + 1), /[ \t\n](style|fill|stroke|stop-color|flood-color|lighting-color|color|bgcolor)[ \t\n]*=[ \t\n]*("[^"]*"|\047[^\047]*\047)/)) {
        st = p + RSTART; p = st + RLENGTH - 1
        colors(substr(m, st, RLENGTH), st - 1, "attribute")
        if (substr(lm, st + 1, 5) == "style") urls(substr(m, st, RLENGTH), st - 1)
      }
      p = 0
      while (match(substr(lm, p + 1), /<(img|script|iframe|video|audio|source|link|embed|object|track|image|use|input)[ \t\n][^>]*>/)) {
        st = p + RSTART; tag = substr(m, st, RLENGTH); p = st + RLENGTH - 1
        for (k = split("src href data poster xlink:href", an, " "); k > 0; k--) {
          v = attr(tag, an[k])
          if (islocal(v)) out(st, "local file " v ": inline it (one file)")
        }
      }
      p = 0
      while (match(substr(lm, p + 1), /<[a-z][a-z0-9-]*[ \t\n][^>]*class[ \t\n]*=[ \t\n]*"([^"]* )?(math|chart)( [^"]*)?"[^>]*>/)) {
        st = p + RSTART; tag = substr(lm, st, RLENGTH); p = st + RLENGTH - 1
        if (tag ~ /"([^"]* )?math( [^"]*)?"/) {
          r = substr(lm, p + 1); sub(/<.*/, "", r)
          if (r !~ /[^ \t\n]/ && substr(lm, p + 1 + length(r), 2) == "</") out(st, "math block is empty: put the TeX in it as text")
        } else if (tag ~ /^<figure/) {
          e = index(substr(lm, p + 1), "</figure")
          if (!e || substr(lm, p + 1, e) !~ /<table/) out(st, "chart has no data table: kit charts draw from a table")
        }
      }
      p = 0
      while ((a = index(substr(lm, p + 1), "<figure")) > 0) {
        a += p; e = index(substr(lm, a), "</figure"); if (!e) break
        p = a + 6
        f = substr(lm, a, e - 1); tag = f; sub(/>.*/, "", tag)
        fa[++nf] = a; fe[nf] = a + e
        if (tag ~ /aria-label/ || f ~ /<figcaption/ || f ~ /[ \t\n]alt="[^"]/) continue
        t = substr(f, length(tag) + 2); gsub(/<[^>]*>/, "", t)
        if (t !~ /[^ \t\n]/) out(a, "figure has no text alternative: add a figcaption or aria-label")
      }
      p = 0
      while ((a = index(substr(lm, p + 1), "<svg")) > 0) {
        a += p; e = index(substr(lm, a), ">"); if (!e) break
        tag = substr(lm, a, e); p = a + e - 1
        b = index(substr(lm, p + 1), "</svg"); body = b ? substr(lm, p + 1, b - 1) : ""
        if (b) p += b
        if (tag ~ /aria-label|aria-hidden="true"|role="(none|presentation)"/ || body ~ /<title|<text/) continue
        for (k = 1; k <= nf && !(a > fa[k] && a < fe[k]); k++);
        if (k <= nf) continue
        out(a, "svg has no text alternative: add aria-label or <title>, or aria-hidden=\"true\" if decorative")
      }
    }
  ' "$1"
}

inject='<meta charset="utf-8"><script>(()=>{const e=window.__check=[],me=location.href.split("#")[0],at=(s,i)=>{const m=/(?:\(|at )(\S+):(\d+):\d+\)?$/.exec(String(s||"").split("\n")[i]||"");return m&&m[1]===me?m[2]:""};if(/^check-/.test(name))document.documentElement.dataset.theme=name.slice(6);const ce=console.error;console.error=function(...a){const x=a.find(v=>v instanceof Error);e.push(["console.error",a.map(String).join(" "),x?at(x.stack,1):at(new Error().stack,2)]);return ce.apply(this,a)};addEventListener("error",v=>{const t=v.target;if(t instanceof Element)e.push(["load failed",t.localName+" "+(t.src||t.href||t.data||""),""]);else e.push(["error",v.message,v.filename===me?v.lineno:""])},true);addEventListener("unhandledrejection",v=>{const r=v.reason;e.push(["unhandled rejection",String(r&&r.message||r),at(r&&r.stack,1)])})})()</script>'

write_wrapper() {
  cat > "$1" <<'EOF'
<!doctype html><meta charset="utf-8"><style>html,body{margin:0;background:#808080}body{display:flex;gap:8px;align-items:start}iframe{border:0;flex:none}</style><pre id="out" hidden></pre><script>
const P = new URLSearchParams(location.hash.slice(1)), W = +P.get('w'), H = +P.get('h'), off = P.has('off'), lines = [];
const ys = P.get('y').split(',').map(Number);
let left = ys.length;
ys.forEach((y, i) => {
  const f = document.createElement('iframe');
  f.name = 'check-' + P.get('theme');
  f.width = W; f.height = H; f.src = P.get('page');
  f.onload = () => setTimeout(() => {
    try {
      f.contentWindow.scrollTo({ top: y, behavior: 'instant' });
      if (P.has('probe') && !i) lines.push(...probe(f.contentWindow));
    } catch (e) { lines.push('note\t-1\tprobe failed: ' + e); }
    if (!--left) document.getElementById('out').textContent = lines.join('\n') + '\nend';
  }, 5000);
  document.body.append(f);
});
function probe(w) {
  const doc = w.document, de = doc.documentElement, vw = de.clientWidth, res = [`size\t${de.scrollHeight}\t${w.innerWidth}`];
  const clean = s => String(s).replace(/\s+/g, ' ').trim().slice(0, 160);
  const vis = el => el.getClientRects().length > 0;
  const h2s = [...doc.querySelectorAll('h2')];
  const sel = el => {
    const parts = [];
    for (; el && el !== doc.body && el !== de; el = el.parentElement) {
      if (el.id) { parts.unshift('#' + el.id); break; }
      let s = el.localName;
      const cls = [...el.classList].filter(c => c !== 'rendered').slice(0, 2);
      if (cls.length) s += '.' + cls.join('.');
      const same = el.parentElement ? [...el.parentElement.children].filter(c => c.localName === el.localName) : [];
      if (same.length > 1) s += `:nth-of-type(${same.indexOf(el) + 1})`;
      parts.unshift(s);
    }
    return parts.slice(-4).join(' > ');
  };
  const add = (msg, el) => {
    let y = -1, where = '';
    if (el && vis(el)) {
      y = Math.round(el.getBoundingClientRect().top + w.scrollY);
      const h = h2s.filter(h => h.compareDocumentPosition(el) & 4).pop();
      where = `y ${y}` + (h ? `, in "${clean(h.textContent).slice(0, 40)}"` : '');
    }
    res.push(['find', y, clean(msg) + (el ? ': ' + sel(el) : ''), where].join('\t'));
  };
  const errs = w.__check || [];
  const remote = [...doc.querySelectorAll('script[src],link[rel~="stylesheet"][href]')].filter(e => /^https?:/.test(e.src || e.href)).length;
  const failed = errs.filter(e => e[0] === 'load failed' && /^\S+ https?:/.test(e[1])).length;
  const net = !off && !(remote && failed >= remote);
  if (!off && !net) res.push('note\t-1\tCDN unreachable: library checks skipped');
  for (const [kind, msg, line] of errs) {
    if (kind === 'load failed' && (!/^\S+ https?:/.test(msg) || !net || /\/cdn-assets@[^/]+\/languages\//.test(msg))) continue;
    add((line ? `line ${line}: ` : '') + kind + ': ' + msg);
  }
  if (de.scrollWidth > vw + 1) {
    const clipped = el => {
      for (let a = el.parentElement; a && a !== de; a = a.parentElement)
        if (w.getComputedStyle(a).overflowX !== 'visible' && a.getBoundingClientRect().right <= vw + 1) return true;
      return false;
    };
    const wide = r => r.width > 0 && (r.right > vw + 1 || r.left < -1);
    const bad = [];
    const take = el => { if (!bad.some(b => b.contains(el)) && !clipped(el)) bad.push(el); };
    doc.body.querySelectorAll('*').forEach(el => { if (wide(el.getBoundingClientRect())) take(el); });
    const tw = doc.createTreeWalker(doc.body, 4), range = doc.createRange();
    for (let t; (t = tw.nextNode());) {
      if (!t.data.trim()) continue;
      range.selectNodeContents(t);
      if (wide(range.getBoundingClientRect())) take(t.parentElement);
    }
    bad.sort((a, b) => a.compareDocumentPosition(b) & 4 ? -1 : 1);
    const msg = `page ${de.scrollWidth}px wide at ${vw}px`;
    if (!bad.length) add(msg + ', culprit not found');
    bad.slice(0, 5).forEach(el => add(`${msg}, ends at ${Math.round(el.getBoundingClientRect().right)}px`, el));
  }
  doc.querySelectorAll('input:not([type="hidden"]), select, textarea, button').forEach(el => {
    if (el.closest('.mock, [aria-hidden="true"], [inert]') || el.getAttribute('aria-label')?.trim() || el.hasAttribute('aria-labelledby') || el.title.trim()) return;
    if ([...(el.labels || [])].some(l => l.textContent.trim()) || (el.localName === 'button' && (el.textContent.trim() || el.querySelector('[aria-label], img[alt]')))) return;
    add(`${el.localName}${el.localName === 'input' ? ' ' + el.type : ''} has no accessible name: put it in a label before any output, or add aria-label`, el);
  });
  const st = el => w.getComputedStyle(el), clip = [], laps = [];
  doc.body.querySelectorAll('main *').forEach(el => {
    const s = st(el);
    if (/hidden|clip/.test(s.overflowX) && s.textOverflow !== 'ellipsis' && el.clientWidth > 8 && el.scrollWidth > el.clientWidth + 2 && el.innerText.trim() && !clip.some(c => c.contains(el))) clip.push(el);
    if (!/flex|grid/.test(s.display)) return;
    const kids = [...el.children].filter(c => { const k = st(c); return vis(c) && !/absolute|fixed/.test(k.position) && k.visibility !== 'hidden' && +k.opacity > 0; }).slice(0, 60);
    const r = kids.map(c => c.getBoundingClientRect());
    for (let i = 0; i < kids.length; i++) for (let j = i + 1; j < kids.length; j++)
      if (Math.min(r[i].right, r[j].right) - Math.max(r[i].left, r[j].left) > 2 && Math.min(r[i].bottom, r[j].bottom) - Math.max(r[i].top, r[j].top) > 2) laps.push([kids[j], kids[i]]);
  });
  clip.slice(0, 5).forEach(el => add(`content clipped, ${el.scrollWidth - el.clientWidth}px cut off`, el));
  laps.slice(0, 5).forEach(([a, b]) => add(`overlaps ${sel(b)}`, a));
  if (net) {
    doc.querySelectorAll('pre.mermaid').forEach(g => {
      if (!(g.dataset.src || '').trim()) return;
      if (g.dataset.processed === 'invalid') return add('Mermaid syntax error, shows as text', g);
      if (!vis(g)) return;
      const svg = g.querySelector('svg');
      if (!svg) add('Mermaid not drawn', g);
      else if (svg.getBoundingClientRect().width < 20) add('Mermaid drawn blank (dispatch kit:shown after showing it)', g);
    });
    doc.querySelectorAll('.chart').forEach(f => { if (vis(f) && f.querySelector('table') && !f.querySelector('canvas')) add('chart not drawn', f); });
    doc.querySelectorAll('.math').forEach(m => {
      const err = m.querySelector('.katex-error');
      if (err) add('TeX error: ' + (err.title || err.textContent), m);
      else if (vis(m) && !m.classList.contains('rendered')) add('math not rendered', m);
    });
    doc.querySelectorAll('pre code[class*="language-"]').forEach(c => {
      if (vis(c) && !c.classList.contains('hljs')) add(`code not highlighted (${c.className.match(/language-\S+/)[0]} unknown?)`, c);
    });
  }
  return res;
}
</script>
EOF
}

launch() {
  ld=$1 url=$2 size=$3; shift 3
  [ -f "$work/nosandbox" ] && set -- "$@" --no-sandbox
  for try in 1 2; do
    "$bin" --headless --disk-cache-dir="$ld/cache" --no-first-run --no-default-browser-check \
      --allow-file-access-from-files --hide-scrollbars --virtual-time-budget=12000 \
      --window-size="$size" --dump-dom "$@" "$url" > "$ld/dom" 2> "$ld/err" &
    pid=$!
    ( trap 'kill "$s" 2>/dev/null; exit 0' TERM; sleep 90 & s=$!; wait "$s"; kill "$pid" 2>/dev/null ) < /dev/null > /dev/null 2>&1 &
    killer=$!
    wait "$pid" || :
    kill "$killer" 2>/dev/null || :
    awk '/<pre id="out"/ { on = 1; sub(/.*<pre id="out"[^>]*>/, "") } on { if (sub(/<\/pre>.*/, "")) { print; exit } print }' "$ld/dom" |
      sed 's/&lt;/</g; s/&gt;/>/g; s/&nbsp;/ /g; s/&amp;/\&/g' > "$ld/res"
    grep -q '^end$' "$ld/res" && return 0
    [ "$try" = 1 ] && grep -qi sandbox "$ld/err" && ! [ -f "$work/nosandbox" ] || return 1
    : > "$work/nosandbox"
    set -- "$@" --no-sandbox
  done
  return 1
}

